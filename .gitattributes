# Normalise line endings.
#
# The project is developed on Windows but built in Linux CI, so text files are
# stored LF in the repository and checked out with the platform's native endings.
# Without this, every file shows as modified when the OS differs.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.pdf binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
public/images/**/*.svg linguist-generated=true
